        <mxCell id="bar0" value="&lt;b&gt;Data Quality — three layers, because relative and absolute tests fail differently&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#333333'&gt;hard bound → QUARANTINE (7 rows)   ·   same clock hour ±24h → FLAG (9)   ·   historical ceiling 165,563 MW → FLAG&lt;/font&gt;" style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#F4F8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;image=data:image/svg+xml,;imageWidth=20;imageHeight=20;imageAlign=left;imageVerticalAlign=middle;spacingLeft=40;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="826" width="1800" height="56" />
        </mxCell>
        <mxCell id="bar1" value="&lt;b&gt;Leakage control — mechanical, not a review step&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#333333'&gt;FeatureSpec declares provenance → audit() checks availability vs cutoff → 47,832 pairs, 0 violations   ·   5 known-leaky features asserted CAUGHT&lt;/font&gt;" style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#F4F8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;image=data:image/svg+xml,;imageWidth=20;imageHeight=20;imageAlign=left;imageVerticalAlign=middle;spacingLeft=40;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
