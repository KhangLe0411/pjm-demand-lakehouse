# Secrets
.env

# Databricks Asset Bundles local state — 252 MB of terraform binaries and providers,
# regenerated by `bundle deploy`. Never commit.
.databricks/

# Data. The landing zone is ~93 MB of Parquet that lives on ADLS; the feature table and
# backtest outputs are rebuilt by scripts/. None of it belongs in git.
data/

# Local MLflow store used by the registry tests
mlruns/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Editor / scratch
*.bak
